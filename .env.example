# TMDB API (v3 key) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Gemini Flash — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override; defaults to gemini-flash-latest
GEMINI_MODEL=

# Telegram Bot — create via @BotFather, chat id via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vercel Cron auth — any long random string
CRON_SECRET=
